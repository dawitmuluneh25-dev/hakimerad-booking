# Copy to `.env.local` and fill in. Values are read by Vite (`VITE_` ones reach
# the browser) and by the Hercules auth middleware (server-only ones).

# --- Convex -----------------------------------------------------------------
# Deployment URL, printed by `pnpm exec convex dev`. Looks like
# https://<deployment-name>.convex.cloud
VITE_CONVEX_URL=

# --- Hercules auth (server only) -------------------------------------------
# OIDC issuer used for discovery: {issuer}/.well-known/openid-configuration.
# For Amazon Cognito this is the user-pool issuer, not the hosted-UI domain.
HERCULES_AUTH_ISSUER_URL=
HERCULES_AUTH_CLIENT_ID=
# Only for a confidential client; omit for PKCE-only.
HERCULES_AUTH_CLIENT_SECRET=
# Random secret of at least 32 characters; the session-cookie key is derived
# from it. Generate one per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every user out.
HERCULES_AUTH_COOKIE_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Public callback URL; only needed behind a TLS-terminating proxy (defaults to
# the incoming request URL). Local dev uses http://localhost:5173/auth/callback.
# HERCULES_AUTH_REDIRECT_URI=
# HERCULES_AUTH_POST_LOGOUT_REDIRECT_URI=
# HERCULES_AUTH_COOKIE_MAX_AGE=
# HERCULES_AUTH_COOKIE_NAME=
# HERCULES_AUTH_COOKIE_DOMAIN=
# HERCULES_AUTH_SCOPE=

# --- Set on the Convex deployment, not here --------------------------------
# `convex/auth.config.ts` reads these from the deployment environment:
#   pnpm exec convex env set HERCULES_OIDC_AUTHORITY <same value as HERCULES_AUTH_ISSUER_URL>
#   pnpm exec convex env set HERCULES_OIDC_CLIENT_ID <same value as HERCULES_AUTH_CLIENT_ID>
