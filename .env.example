# Copy to `.env.local` (Vite loads it automatically). Everything is local except
# the OIDC provider you choose; no hosted backend or build service is involved.

# --- Local storage ----------------------------------------------------------
# SQLite file and upload directory, created on first run. Defaults are fine.
# DATABASE_PATH=./data/app.db
# DATA_DIR=./data

# --- Sign-in (OIDC) ---------------------------------------------------------
# Any standards-compliant issuer works: Cognito, Keycloak, Auth0, Entra ID.
# Sign-in is disabled (503 on /auth/sign-in) until the first two are set.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
# Only for a confidential client; omit for PKCE-only public clients.
AUTH_CLIENT_SECRET=
# Random secret of at least 32 characters; the session cookie is encrypted with
# a key derived from it. Generate one per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every user out.
AUTH_COOKIE_SECRET=

# --- Optional ---------------------------------------------------------------
# Public callback URL; only needed behind a TLS-terminating proxy (defaults to
# the incoming request origin). Local dev uses http://localhost:5173/auth/callback.
# AUTH_REDIRECT_URI=
# AUTH_SCOPE=openid profile email

# --- Local testing only ------------------------------------------------------
# Enables /auth/dev-login, which mints a session for a chosen role so the staff
# screens can be exercised without an identity provider. Never enable it in a
# production build (the route returns 404 when NODE_ENV=production).
# AUTH_DEV_LOGIN=1
